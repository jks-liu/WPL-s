{
	"name": "wpls",
	"displayName": "WPL/s - Zhihu Write Publish Loop w/ statistic",
	"description": "使用 Markdown 在 VS Code 中进行知乎创作（回答问题，写专栏文章）",
	"version": "2.0.0",
	"publisher": "jks-liu",
	"license": "MIT",
	"enableProposedApi": false,
	"engines": {
		"vscode": "^1.134.0"
	},
	"keywords": [
		"zhihu",
		"知乎专栏",
		"writing",
		"知乎",
		"Markdown",
		"wpls",
		"wpl/s",
		"wpl",
		"写作"
	],
	"categories": [
		"Notebooks"
	],
	"activationEvents": [
		"onCommand:zhihu.openWebView",
		"onCommand:zhihu.publish",
		"onCommand:zhihu.drafts",
		"onCommand:zhihu.search",
		"onCommand:zhihu.login",
		"onCommand:zhihu.logout",
		"onCommand:zhihu.uploadImageFromClipboard",
		"onCommand:zhihu.uploadImageFromPath",
		"onCommand:zhihu.uploadImageFromExplorer",
		"onCommand:zhihu.atPeople",
		"onView:zhihu-actions",
		"onLanguage:markdown"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/jks-liu/WPL-s"
	},
	"icon": "res/media/outline_local_cafe_black_48dp.png",
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "zhihu-explorer",
					"title": "知乎",
					"icon": "res/media/local_cafe_black_48dp.svg"
				}
			]
		},
		"views": {
			"zhihu-explorer": [
				{
					"id": "zhihu-actions",
					"name": "快捷操作"
				}
			]
		},
		"commands": [
			{
				"command": "zhihu.openWebView",
				"title": "Zhihu: openWebView"
			},
			{
				"command": "zhihu.clearCache",
				"title": "Zhihu: Clear Cache"
			},
			{
				"command": "zhihu.search",
				"title": "Zhihu: Search Items",
				"icon": {
					"light": "res/media/light/search_black_24dp.svg",
					"dark": "res/media/dark/search_white_24dp.svg"
				}
			},
			{
				"command": "zhihu.publish",
				"title": "Zhihu: Publish",
				"icon": {
					"light": "res/media/light/publish_black_24dp.svg",
					"dark": "res/media/dark/publish_white_24dp.svg"
				}
			},
			{
				"command": "zhihu.drafts",
				"title": "Zhihu: drafts",
				"icon": {
					"light": "res/media/light/drafts_black_24dp.svg",
					"dark": "res/media/dark/drafts_white_24dp.svg"
				}
			},
			{
				"command": "zhihu.uploadImageFromClipboard",
				"title": "Zhihu: Paste Image From Clipboard"
			},
			{
				"command": "zhihu.uploadImageFromPath",
				"title": "Zhihu: Upload Image From Path"
			},
			{
				"command": "zhihu.uploadImageFromExplorer",
				"title": "Zhihu: Upload Image From Explorer"
			},
			{
				"command": "zhihu.atPeople",
				"title": "Zhihu: @ Zhihuer"
			},
			{
				"command": "zhihu.login",
				"title": "Zhihu: Login",
				"icon": {
					"light": "res/media/light/login_black_24dp.svg",
					"dark": "res/media/dark/login_white_24dp.svg"
				}
			},
			{
				"command": "zhihu.logout",
				"title": "Zhihu: Logout"
			}
		],
		"keybindings": [
			{
				"command": "zhihu.uploadImageFromClipboard",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p"
			},
			{
				"command": "zhihu.uploadImageFromPath",
				"key": "ctrl+alt+q",
				"mac": "cmd+alt+p"
			},
			{
				"command": "zhihu.uploadImageFromExplorer",
				"key": "ctrl+alt+f",
				"mac": "cmd+alt+e"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "zhihu.publish",
					"when": "resourceLangId == markdown",
					"group": "zhihu@0"
				},
				{
					"command": "zhihu.uploadImageFromExplorer",
					"when": "resourceLangId == markdown",
					"group": "zhihu@2"
				}
			],
			"editor/title": [
				{
					"command": "zhihu.publish",
					"when": "resourceLangId == markdown",
					"group": "navigation@0"
				},
				{
					"command": "zhihu.drafts",
					"when": "resourceLangId == markdown",
					"group": "navigation@1"
				}
			],
			"explorer/context": [
				{
					"command": "zhihu.uploadImageFromPath",
					"group": "extension",
					"when": "resourceExtname == .png || resourceExtname == .gif || resourceExtname == .jpg"
				}
			],
			"view/title": [
				{
					"command": "zhihu.login",
					"when": "view == zhihu-actions && !zhihu.authenticated",
					"group": "navigation@0"
				},
				{
					"command": "zhihu.search",
					"when": "view == zhihu-actions",
					"group": "navigation@1"
				},
				{
					"command": "zhihu.logout",
					"when": "view == zhihu-actions && zhihu.authenticated",
					"group": "secondary"
				}
			]
		},
		"configuration": {
			"title": "Zhihu",
			"properties": {
				"zhihu.useVSTheme": {
					"type": "boolean",
					"default": true,
					"description": "Use VSCode default theme color, set false to disable"
				},
				"zhihu.isTitleImageFullScreen": {
					"type": "boolean",
					"default": false,
					"description": "Set true to enable full-sized background image"
				},
				"zhihu.useWaterMark": {
					"type": "boolean",
					"default": false,
					"description": "Set true to enable watermark"
				},
				"zhihu.browserChannel": {
					"type": "string",
					"enum": [
						"auto",
						"chrome",
						"msedge"
					],
					"default": "auto",
					"scope": "machine",
					"description": "用于知乎登录的浏览器。auto 在 Windows 上优先 Edge，在其他系统上优先 Chrome。"
				},
				"zhihu.browserExecutablePath": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "可选：用于知乎登录的 Chrome/Chromium/Edge 可执行文件绝对路径；设置后优先于 browserChannel。"
				}
			}
		},
		"markdown.markdownItPlugins": true,
		"markdown.previewStyles": [
			"./node_modules/katex/dist/katex.min.css"
		]
	},
	"scripts": {
		"version:bump": "node scripts/version-bump.js",
		"vscode:prepublish": "npm run package",
		"develop": "webpack --mode development --watch",
		"clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run clean && npm run compile && node ./out/test/runTest.js",
		"lint": "eslint \"{src,test}/**/*.ts\"",
		"package": "webpack --mode production --devtool hidden-source-map",
		"vsix": "vsce package"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/ali-oss": "^6.23.3",
		"@types/markdown-it": "14.2.0",
		"@types/md5": "^2.3.6",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.1",
		"@types/pug": "^2.0.10",
		"@types/vscode": "1.134.0",
		"@typescript-eslint/eslint-plugin": "^8.64.0",
		"@typescript-eslint/parser": "^8.64.0",
		"@vscode/test-electron": "3.1.0",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^10.7.0",
		"glob": "^13.0.6",
		"globals": "^17.7.0",
		"ignore-loader": "^0.1.2",
		"mocha": "^11.7.6",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"webpack": "^5.108.4",
		"webpack-cli": "^7.2.1"
	},
	"dependencies": {
		"@vscode/markdown-it-katex": "^1.1.2",
		"ali-oss": "6.23.0",
		"linkify-it": "5.0.2",
		"markdown-it": "14.3.0",
		"markdown-it-meta": "^0.0.1",
		"markdown-it-zhihu-common": "^1.3.1",
		"md5": "^2.3.0",
		"playwright-core": "1.62.1",
		"pug": "^3.0.4"
	},
	"overrides": {
		"diff": "8.0.4",
		"linkify-it@<5.0.2": "5.0.2",
		"serialize-javascript": "7.1.0"
	}
}
