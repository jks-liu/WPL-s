{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"types": ["node", "mocha", "vscode"],
		"lib": ["ES2022", "DOM"]
	},
	"include": [
		"test/**/*",
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		".vscode-test",
	]
}
